<?xml version="1.0" encoding="utf-8"?>
<!-- Файлы VK Tools для одного года Revit. Переменные YEAR и Guid* задаёт Package.wxs. -->
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="Revit$(var.YEAR)">
      <Component Id="Manifest$(var.YEAR)" Directory="Addins$(var.YEAR)" Guid="$(var.GuidManifest)">
        <File Id="Addin$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/VKTools.addin" />
        <RegistryValue Root="HKCU" Key="Software\VKTools\$(var.YEAR)" Name="Manifest" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveAddins$(var.YEAR)" On="uninstall" />
      </Component>
      <Component Id="Binaries$(var.YEAR)" Directory="VKTools$(var.YEAR)" Guid="$(var.GuidBinaries)">
        <File Id="Dll$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/VKTools.dll" />
        <File Id="CoreDll$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/VKTools.Core.dll" />
        <RegistryValue Root="HKCU" Key="Software\VKTools\$(var.YEAR)" Name="Binaries" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveVKTools$(var.YEAR)" On="uninstall" />
      </Component>
      <Component Id="Config$(var.YEAR)" Directory="Config$(var.YEAR)" Guid="$(var.GuidConfig)">
        <File Id="CfgParameters$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/parameters.csv" />
        <File Id="CfgCategories$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/vk_categories.csv" />
        <File Id="CfgUpdaters$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/updaters.csv" />
        <File Id="CfgInsulation$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/insulation_from_host.csv" />
        <File Id="CfgLookalike$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/lookalike_values.csv" />
        <File Id="CfgNested$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/nested_params.csv" />
        <File Id="CfgGrouping$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/grouping.csv" />
        <File Id="CfgKits$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/kit_params.csv" />
        <File Id="CfgCalcResources$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/calc_resources.csv" />
        <File Id="CfgCalcPipes$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/calc_pipe_rules.csv" />
        <File Id="CfgCalcSupports$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/calc_supports.csv" />
        <File Id="CfgCalcCord$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/calc_cord.csv" />
        <File Id="CfgCalcReserve$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/calc_reserve.csv" />
        <File Id="CfgScheduleForm$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/schedule_form.csv" />
        <File Id="CfgScheduleGroups$(var.YEAR)" Source="$(var.BinDir)$(var.YEAR)/config/schedule_groups.csv" />
        <RegistryValue Root="HKCU" Key="Software\VKTools\$(var.YEAR)" Name="Config" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveConfig$(var.YEAR)" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Include>
