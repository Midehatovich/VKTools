<?xml version="1.0" encoding="utf-8"?>
<!--
  Манифест надстройки. Лежит в %AppData%\Autodesk\Revit\Addins\<год>\,
  DLL — в подпапке VKTools\ рядом с ним (путь относительный).
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>VK Tools</Name>
    <Assembly>VKTools\VKTools.dll</Assembly>
    <FullClassName>VKTools.Revit.App</FullClassName>
    <ClientId>4F6C2B7E-93A1-4D5E-8C2F-6B1E0A9D7C35</ClientId>
    <VendorId>VKTOOLS</VendorId>
    <VendorDescription>VK Tools, отдел ВК</VendorDescription>
  </AddIn>
</RevitAddIns>
