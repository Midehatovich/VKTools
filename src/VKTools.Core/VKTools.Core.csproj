  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <RootNamespace>VKTools.Core</RootNamespace>
    <AssemblyName>VKTools.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VKTools.Core.Tests" />
  </ItemGroup>
</Project>
