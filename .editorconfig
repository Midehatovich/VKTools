root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[*.{csproj,props,targets,wxs,wixproj,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Правила, которые предлагают API только из .NET 8: код собирается и под .NET Framework 4.8 (Revit 2021–2024).
dotnet_diagnostic.CA1510.severity = none   # ArgumentNullException.ThrowIfNull
dotnet_diagnostic.CA1865.severity = none   # StartsWith(char)
dotnet_diagnostic.CA1866.severity = none
dotnet_diagnostic.CA1847.severity = none   # Contains(char)
dotnet_diagnostic.CA2249.severity = none   # string.Contains(string, StringComparison)
dotnet_diagnostic.CA1870.severity = none   # SearchValues
dotnet_diagnostic.CA1845.severity = none   # AsSpan / string.Concat(ReadOnlySpan)
# Имена из предметной области: GUID параметра ФОП, уровень лога Error.
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1716.severity = none
